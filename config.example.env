XAVI_SKY_NODE_ID=xavi-sky-prod4
XAVI_SKY_NODE_KIND=server
XAVI_SKY_DATA_DIR=/datastore3/xavi-sky/data
XAVI_SKY_THEMES=artificial intelligence|cybersecurity|open source|technology|canada|british columbia
MAX_CANDIDATES=6000
PACKS_PER_THEME=6
RUN_DEADLINE_MS=240000

# Pipe-separated peer roots. Each peer maintains its own SQLite replica.
# XAVI_SKY_PEERS=https://www.xavi.app|https://sky-vps2.example.com
# XAVI_SKY_FEDERATION_TOKEN is normally supplied as a secret; on servers a token file is preferred.
XAVI_SKY_FEDERATION_TOKEN_FILE=/datastore3/xavi-sky/secrets/federation.token
